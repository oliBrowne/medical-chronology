# Copy to .env and fill in. .env is gitignored.
# Each person should use their own UMLS key from https://uts.nlm.nih.gov/ (the
# UMLS license is per person and does not allow sharing keys).
UMLS_API_KEY=
# SNOMED CT search uses a local index built from your UMLS download
# (scripts/umls/build_snomed_index.py). Optional: point at a specific index file.
# SNOMED_INDEX=data/umls/snomed_2025AB.sqlite
# Development only: with no local index, search the UMLS web API instead.
# UMLS_WEB_FALLBACK=yes

# TypeSafe Jev API key from https://console.typesafe.ai/keys (used by scripts/jev/).
# Don't send real record text until zero data retention is on for the org.
TYPESAFE_API_KEY=
