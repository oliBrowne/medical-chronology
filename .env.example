# Copy to .env and fill in. .env is gitignored.
# Each person should use their own UMLS key from https://uts.nlm.nih.gov/ (the
# UMLS license is per person and does not allow sharing keys).
UMLS_API_KEY=

# Local SNOMED CT index built from your UMLS download (docs/snomed-index.md).
# Defaults to data/umls/snomed.sqlite.
SNOMED_INDEX=

# Development only: let snomed_search fall back to the UMLS web API when no
# local index exists. This sends the phrase to NLM, so made-up phrases only.
UMLS_WEB_FALLBACK=

# TypeSafe Jev API key from https://console.typesafe.ai/keys (used by scripts/jev/).
# Don't send real record text until zero data retention is on for the org.
TYPESAFE_API_KEY=
